ACE_HOST=0.0.0.0
ACE_PORT=8080

ACE_LOG_DIR=runtime/logs
ACE_AUDIO_DIR=runtime/audio

ACE_ASR_SERVER=grpc.nvcf.nvidia.com:443
ACE_ASR_HTTP_URL=http://127.0.0.1:9000
ASSISTANT_LANGUAGE=en-US
ASR_LANGUAGE=en-US
TTS_LANGUAGE=en-US
ACE_ASR_USE_HOSTED_API=true
ACE_ASR_USE_SSL=true
ACE_ASR_FUNCTION_ID=b0e8b4a5-217c-40b7-9b96-17d84e666317
# Empty ASR key falls back to ACE_NIM_API_KEY.
ACE_ASR_API_KEY=
ACE_ASR_MODEL=
ACE_ASR_SAMPLE_RATE_HZ=16000
ACE_ASR_FRAME_MS=20

ACE_TTS_SERVER=127.0.0.1:50052
ACE_TTS_HTTP_URL=http://127.0.0.1:9001
ACE_TTS_USE_HOSTED_API=true
ACE_TTS_API_URL=https://877104f7-e885-42b9-8de8-f6e4c6303969.invocation.api.nvcf.nvidia.com/v1/audio/synthesize
ACE_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
ACE_TTS_SAMPLE_RATE_HZ=44100
ACE_TTS_ENCODING=LINEAR_PCM

ACE_NIM_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
ACE_NIM_API_KEY=
ACE_NIM_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
ACE_SKIP_LLM_MODEL_VALIDATION=false
ACE_VALIDATE_EXTERNALS_ON_STARTUP=false
# Leave blank to use the prompt for ASSISTANT_LANGUAGE.
ACE_SYSTEM_PROMPT=

ACE_VAD_AGGRESSIVENESS=2
ACE_EOS_SILENCE_MS=500
ACE_SAVE_DEBUG_AUDIO=true
ACE_MOCK_ASR=false
ACE_MOCK_TTS=false
ACE_MOCK_LLM=false
